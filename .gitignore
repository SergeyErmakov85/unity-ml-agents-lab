# Unity .gitignore Template
# Source: https://github.com/github/gitignore/blob/main/Unity.gitignore
# Last synced: 2025-12-18
# License: CC0-1.0
#
# This template is maintained from the github/gitignore repository
# and distributed under Creative Commons Zero v1.0 Universal license.

# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# ВНИМАНИЕ: Unity-проект живёт в unity/MLAgentsLab/, а .gitignore — в корне репозитория,
# поэтому Unity-шаблонные пути якорятся не на "/", а на "unity/MLAgentsLab/".
.utmp/
unity/MLAgentsLab/[Ll]ibrary/
unity/MLAgentsLab/[Tt]emp/
unity/MLAgentsLab/[Oo]bj/
unity/MLAgentsLab/[Bb]uild/
unity/MLAgentsLab/[Ll]ogs/
unity/MLAgentsLab/[Uu]ser[Ss]ettings/
unity/MLAgentsLab/[Mm]emoryCaptures/
unity/MLAgentsLab/[Rr]ecordings/
/[Bb]uilds/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be committed to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data

# Recordings can get excessive in size

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
unity/MLAgentsLab/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
unity/MLAgentsLab/ServerData
unity/MLAgentsLab/[Aa]ssets/StreamingAssets/aa*
unity/MLAgentsLab/[Aa]ssets/AddressableAssetsData/link.xml*
unity/MLAgentsLab/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
unity/MLAgentsLab/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
unity/MLAgentsLab/[Aa]ssets/AssetStoreTools*

# Python / ML training artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.onnx.tmp

# .meta обученных моделей коммитятся ВМЕСТЕ с .onnx. Без .meta Unity создаст
# новый GUID при каждом клоне, и ссылка на модель в BehaviorParameters сломается.
# Модель — часть примера (определение 1.2), а не артефакт сборки.

# Временная сцена проверки инференса: создаётся и удаляется InferenceBuild.
unity/MLAgentsLab/[Aa]ssets/Shared/Temp/
unity/MLAgentsLab/[Aa]ssets/Shared/Temp.meta

# Прогоны обучения: каталог игнорируется целиком, кроме описания схемы
/results/*
!/results/README.md

# Генерируется com.unity.test-framework.performance при каждом запуске редактора:
# содержит список пакетов и параметры машины, то есть меняется у каждого разработчика.
unity/MLAgentsLab/[Aa]ssets/Resources/PerformanceTestRun*.json
unity/MLAgentsLab/[Aa]ssets/Resources/PerformanceTestRun*.json.meta
